# Containerization

# install whalebrew so we can install dockerized apps
brew "whalebrew"

# containerization
## container runtimes, management, etc
brew "container" # apple container tool
# cask "docker" # docker desktop
# brew "docker-engine" # open source docker engine
brew "docker" # docker cli
brew "docker-buildx"
brew "docker-compose"
brew "docker-credential-helper"
# brew "lima"
brew "colima"
brew "lima-additional-guestagents"
# cask "orbstack"
# cask "rancher"

## container security
brew "anchore/grype/grype", trusted: true # vulnerability scanner for container images and filesystems
brew "anchore/syft/syft", trusted: true  # generates SBOMs from container images and filesystems
brew "dive" # explore a docker image, layer contents, and discover ways to shrink your Docker image size
brew "goodwithtech/r/dockle", trusted: true # container image linter for security best practices
brew "snyk/tap/snyk", trusted: true
brew "trivy" # container vulnerability/misconfiguration scanner

## container tooling
brew "homeport/tap/forklift", trusted: true # manuipulate container images, layers, and filesystems
